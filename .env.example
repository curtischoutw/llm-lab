# RAG 實驗設定範本：複製成 .env 後依環境修改（cp .env.example .env）。
# .env 不進版本控管，可以放金鑰。所有欄位都必填，缺漏或格式錯誤時 CLI 會在啟動時中止。
# 預設值對應本機 MLX server：LLM 在 8080（mlx_lm.server），VLM 與 embedding 在 8081（mlx_vlm.server）。
# 搬到別台機器或換雲端 API 時，只改這份檔案，程式碼不動。

# ------------------------------
# LLM（文字模型：實體抽取、答案生成）
# ------------------------------
# OpenAI 相容端點的 base URL，必須是 http(s)，結尾含 /v1
LLM_BASE_URL=http://127.0.0.1:8080/v1
# 送給端點的模型名稱。換更大的 LLM 時改這兩項（LLM_BASE_URL 與 LLM_MODEL）即可
LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
# API 金鑰。本機 MLX server 不驗證，填任意非空字串；雲端 API 填真金鑰
LLM_API_KEY=local-mlx

# ------------------------------
# VLM（看圖模型：描述論文中的圖片）
# ------------------------------
VLM_BASE_URL=http://127.0.0.1:8081/v1
VLM_MODEL=mlx-community/Qwen3-VL-4B-Instruct-4bit
VLM_API_KEY=local-mlx

# ------------------------------
# Embedding（向量模型）
# ------------------------------
# 注意：索引建好後 embedding 模型與維度即鎖定，更換必須重建索引
EMBED_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=mlx-community/Qwen3-Embedding-0.6B-8bit
EMBED_API_KEY=local-mlx
# 向量維度，必須是正整數且與模型實際輸出一致（Qwen3-Embedding-0.6B 實測為 1024）。
# scripts/smoke_test.py 會印出端點的實測維度，可據此填寫
EMBED_DIM=1024
# 單次送進 embedding 的最大 token 數，必須是正整數
EMBED_MAX_TOKEN_SIZE=8192
# 查詢端的 instruction 前綴（非對稱 embedding）；文件端不加。選填，留空表示不加前綴。
# .env 內以字面 \n 表示換行
EMBED_QUERY_PREFIX=Instruct: Given a question, retrieve relevant passages that answer the question\nQuery:

# ------------------------------
# 儲存路徑（皆不進版本控管）
# ------------------------------
# LightRAG 索引與知識圖譜的資料夾
WORKING_DIR=./rag_storage
# 文件解析（MinerU）的輸出資料夾
PARSER_OUTPUT_DIR=./output

# ------------------------------
# Office 文件轉 PDF（macOS）
# ------------------------------
# 不是 rag_lab 的設定欄位，是給 LibreOffice 子行程的環境變數。
# macOS 上的 headless LibreOffice 看不到系統字型，Office 文件裡的中文轉成 PDF 時會消失。
# 取消註解並改成 repo 的絕對路徑（相對路徑會依 LibreOffice 的工作目錄解析）：
# FONTCONFIG_FILE=/絕對路徑/llm-lab/scripts/libreoffice-fonts-macos.conf

# ------------------------------
# 併發與輸出長度
# ------------------------------
# LLM 並行請求數（正整數）。本機 32 GB 機器實測：2 會讓 mlx_lm.server GPU 記憶體不足，1 能跑完
LLM_MAX_ASYNC=1
# embedding 並行請求數（正整數）。本機 mlx_vlm.server 實測以 1 跑完整篇 ingest；
# 更高的值未驗證是否穩定
EMBED_MAX_ASYNC=1
# LLM 最大輸出 token 數（正整數）。要夠大，否則實體抽取的輸出會被截斷
# （mlx_lm.server 啟動時也要加 --max-tokens 4096，其預設 512 會截斷）
LLM_MAX_TOKENS=4096
# VLM 最大輸出 token 數（正整數），每次呼叫都明確帶上，不依賴 server 預設值
VLM_MAX_TOKENS=1024
# 查詢時送給 LLM 的 context 總 token 上限（正整數）。LightRAG 預設 30000；本機 32 GB 機器實測
# 29.7k token 的 prompt 會讓 mlx_lm.server GPU 記憶體不足
QUERY_MAX_TOTAL_TOKENS=12000
# 圖譜 context 裡 entity 與 relation 各自的 token 上限（0 以上的整數；兩者相加必須小於總上限）。
# 總上限扣掉這兩項，剩下的 token 全部留給文字 chunk。LightRAG 預設是 6000／8000（對 30000），
# 依這個比例縮到 12000 是 2400／3200，mix 模式的 context 只剩 3–8 個 chunk。
# ticket 09 的 7 題未通過題目，只跑檢索，數參考答案的關鍵字句進了 context 幾個（滿分 21）：
# 2400／3200 是 7，1500／2000 是 7，1000／1000 是 10，500／500 是 13，0／0 是 11。所以用 500／500。
# 0 是合法值：LightRAG 照常執行，只是不放該類描述；但兩者都是 0 時，local、global、hybrid 沒有任何 context，
# 查詢會失敗（mix 與 naive 仍有文字 chunk，可以執行）
# 完整 eval 實測（2026-11-01）：500／500 時 mix 答對的題目從 4 題增加到 7 題，但 local、global、hybrid 減少
# （4→2、8→4、4→1），因為 relation 從每題約 40 個降到 5–11 個。使用者只用 mix，所以維持 500／500。
QUERY_MAX_ENTITY_TOKENS=500
QUERY_MAX_RELATION_TOKENS=500
